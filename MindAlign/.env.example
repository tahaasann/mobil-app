# Copy to .env and adjust locally. Never commit .env.
APP_ENV=development

# App Check debug tokens (Firebase Console > App Check > Manage debug tokens)
# Prefer non-EXPO_PUBLIC secret injection for production debug builds via EAS secrets.
EXPO_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN_ANDROID=
EXPO_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN_IOS=

# EXPO_PUBLIC_AI_MOCK=true
# EXPO_PUBLIC_AUTH_MOCK=true  # recommended with AI/ADS mock for local emulator runs
# EXPO_PUBLIC_SYNC_MOCK=true
# EXPO_PUBLIC_NOTIFICATION_MOCK=true
# EXPO_PUBLIC_SUBSCRIPTION_MOCK=true
# EXPO_PUBLIC_ADS_MOCK=true
# EXPO_PUBLIC_SERVER_AI_QUOTA=false
# EXPO_PUBLIC_AI_QUOTA_BASE_URL=
# EXPO_PUBLIC_ANALYTICS_MOCK=true
# EXPO_PUBLIC_CRASHLYTICS_MOCK=true
# EXPO_PUBLIC_REMOTE_CONFIG_MOCK=true
# EXPO_PUBLIC_REVIEW_MOCK=true
# EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
# EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://mindalign.app/privacy
# EXPO_PUBLIC_TERMS_URL=https://mindalign.app/terms
# Legacy dev fallback (not accepted in production guard):
# EXPO_PUBLIC_REVENUECAT_API_KEY=
# EXPO_PUBLIC_ADMOB_APP_ID_ANDROID=
# EXPO_PUBLIC_ADMOB_APP_ID_IOS=
# EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID_ANDROID=
# EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID_IOS=
# EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
# EXPO_PUBLIC_GEMINI_LITE_MODEL=gemini-2.5-flash-lite
