# Copy to .env and adjust locally. Never commit .env.
APP_ENV=development

# App Check debug tokens (Firebase Console > App Check > Manage debug tokens)
# Generate one token per platform and paste here for local dev builds.
EXPO_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN_ANDROID=
EXPO_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN_IOS=

